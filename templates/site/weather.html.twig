{% extends 'base.html.twig' %}
{% block title %}Météo · MiniSite{% endblock %}

{% block body %}
  <h1>Météo</h1>

  <form method="get" class="card" style="display:flex; gap:8px; align-items:center;">
    <label for="ville" class="muted">Ville</label>
    <input id="ville" name="ville" value="{{ query_city }}" style="flex:1; padding:8px; border:1px solid #cbd5e0; border-radius:10px;">
    <button class="btn btn-primary">Afficher</button>
  </form>

  {% if error %}
    <div class="card">😕 {{ error }}</div>
  {% elseif current %}
    <div class="card">
      <h2 style="margin-top:0;">{{ current.city }} ({{ current.country }})</h2>
      <p style="font-size:24px; margin:0;">🌡️ {{ current.temperature }} °C</p>
      <p class="muted" style="margin:6px 0 0 0;">Vent : {{ current.windspeed }} km/h</p>
      <p class="muted" style="margin:6px 0 0 0;">Code météo : {{ current.weathercode }}</p>
      <p class="muted" style="margin-top:12px;">(Données : Open-Meteo)</p>
    </div>
  {% else %}
    <div class="card">Entrez une ville et validez pour voir la météo.</div>
  {% endif %}
{% endblock %}
